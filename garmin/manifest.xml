<?xml version="1.0"?>
<!--

  HITT Connect IQ — app manifest

  The `application id` UUID is HITT's permanent app identity in the Connect
  IQ Store. Generated once (2026-07-01) — never change it. If it changes,
  Garmin treats future uploads as a different app and existing users can't
  install updates.

  Target SDK floor: 4.0.0 (devices released 2022+). See README.md.

-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">

  <iq:application
    entry="HittApp"
    id="93d5f6cd-0cb7-4dca-aae4-90762c9d0728"
    launcherIcon="@Drawables.LauncherIcon"
    minSdkVersion="4.0.0"
    name="@Strings.AppName"
    type="watch-app"
    version="0.2.9">

    <iq:products>
      <!-- Forerunner -->
      <iq:product id="fr165"/>
      <iq:product id="fr165m"/>
      <iq:product id="fr255"/>
      <iq:product id="fr255s"/>
      <iq:product id="fr255m"/>
      <iq:product id="fr255sm"/>
      <iq:product id="fr265"/>
      <iq:product id="fr265s"/>
      <iq:product id="fr955"/>
      <iq:product id="fr965"/>

      <!-- Fenix / Epix (Fenix 8 not yet in SDK 9.2.0 device catalogue — add
           when Garmin publishes a device profile, likely SDK 9.3+) -->
      <iq:product id="fenix7"/>
      <iq:product id="fenix7pro"/>
      <iq:product id="fenix7s"/>
      <iq:product id="fenix7spro"/>
      <iq:product id="fenix7x"/>
      <iq:product id="fenix7xpro"/>
      <iq:product id="epix2"/>
      <iq:product id="epix2pro42mm"/>
      <iq:product id="epix2pro47mm"/>
      <iq:product id="epix2pro51mm"/>

      <!-- Venu -->
      <iq:product id="venu3"/>
      <iq:product id="venu3s"/>
      <iq:product id="venusq2"/>
      <iq:product id="venusq2m"/>

      <!-- Edge -->
      <iq:product id="edge540"/>
      <iq:product id="edge840"/>
      <iq:product id="edge1040"/>
      <iq:product id="edge1050"/>

      <!-- Instinct (Instinct 3 has device-specific IDs — instinct3amoled45mm
           etc. — add later; keeping v0.1.0 tight to the Instinct 2 family) -->
      <iq:product id="instinct2"/>
      <iq:product id="instinct2s"/>
      <iq:product id="instinct2x"/>
    </iq:products>

    <iq:permissions>
      <!-- Fit + Sensor cover activity recording. Positioning gives the
           live UI its own GPS event stream so distance climbs on-screen
           for the user (ActivityRecording auto-enables GPS internally
           for the FIT file, but on some firmwares Activity.getActivityInfo()
           stays null for the UI until Positioning is also subscribed).
           Communications is the direct HTTP push path to
           push-garmin-watch-workout (see source/PushClient.mc).
           PersistedContent stores the pairing JWT between app launches
           so we don't re-pair every session. -->
      <iq:uses-permission id="Fit"/>
      <iq:uses-permission id="Sensor"/>
      <iq:uses-permission id="Positioning"/>
      <iq:uses-permission id="Communications"/>
      <iq:uses-permission id="PersistedContent"/>
    </iq:permissions>

    <iq:languages>
      <iq:language>eng</iq:language>
    </iq:languages>

    <iq:barrels/>

  </iq:application>

</iq:manifest>
