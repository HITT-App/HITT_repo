<!--
  HITT Connect IQ — user-facing strings (English).

  MVP (v0.1.0): sport picker + native activity recording. The BLE-paired
  flow (CIQ-02..07 per SPEC_garmin_connect_iq.md) adds more strings later.
-->
<strings>

  <string id="AppName">HITT</string>

  <!-- Sport picker -->
  <string id="MenuTitle">Choose sport</string>
  <string id="SportRun">Run</string>
  <string id="SportWalk">Walk</string>
  <string id="SportBike">Bike</string>
  <string id="SportSwim">Swim</string>
  <string id="SportStrength">Strength</string>
  <string id="SportHIIT">HIIT</string>

  <!-- Recording -->
  <string id="Paused">PAUSED</string>

  <!-- Save prompt -->
  <string id="SavePrompt">Save this workout?</string>

  <!-- Post-save confirmation flash -->
  <string id="Saved">Saved</string>

  <!-- Pair with iPhone (visible only when unpaired) -->
  <string id="MenuPair">Pair with iPhone</string>
  <string id="MenuPairSub">Sends workouts straight to HITT</string>

  <!-- Reset pairing (visible only when a JWT is stored — self-serve
