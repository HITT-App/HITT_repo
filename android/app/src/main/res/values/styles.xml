<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- Launch theme: shows @drawable/splash as the window background
         while the WebView is loading. Inherits from AppTheme.NoActionBar
         so no title/action bar appears above the WebView once loaded.
         (Previously inherited from Theme.SplashScreen, which requires
         installSplashScreen() to be called from onCreate to transition
         to a post-splash theme. Capacitor's BridgeActivity doesn't call
         it, so the theme stayed on the AppCompat default with an action
         bar — hidden pre-Android-15 by setOverlaysWebView(false), but
         exposed once we moved to edge-to-edge.) -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>