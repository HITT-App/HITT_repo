<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ requires runtime POST_NOTIFICATIONS permission. Without
         this declaration `PushNotifications.requestPermissions()` silently
         returns "denied" without ever prompting the user. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera + microphone for the in-WebView getUserMedia surfaces: the body
         scan and barcode scanner (video), and the voice coach (audio). We use
         getUserMedia directly rather than @capacitor/camera, so no plugin
         injects these for us and they have to be declared here.

         Capacitor's BridgeWebChromeClient.onPermissionRequest DOES ask for
         CAMERA / RECORD_AUDIO at runtime when the WebView requests capture —
         but Android auto-denies a runtime request for an undeclared
         permission, silently. The user then sees "Could not access camera.
         Please check permissions." with no permission to grant in Settings,
         because an undeclared permission never appears there.
         Shipped without these in versionCode 12; reported by a user. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Declaring CAMERA implies android.hardware.camera is REQUIRED, which
         would hide the app on Play from any device without one. Both features
         are optional to the app, so opt out of that filtering explicitly. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Health Connect (read) — the surface we already query on iOS's
         HealthKit via @capgo/capacitor-health. Mirror the read list in
         useHealthProfile.ts and useWatchSync.ts. Each of these needs a
         matching business-justification in the Play Console → App
         content → Health Connect permissions declaration form. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />

    <!-- Health Connect (write) — matches the iOS HealthWritePlugin.swift
         surface for GPS activity write-back (Apple Fitness / Google Fit
         gets our recorded runs, walks, and cycles + calories burned). -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />

    <!-- Health Connect discovers apps that request these permissions via a
         package query. Required for Android 11+ so PackageManager returns
         the Health Connect app when we probe for it (isAvailable, etc.). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <!-- Strip the @capgo/capacitor-health plugin's excess permissions.
         The plugin declares 41 different Health Connect records including
         blood glucose, blood pressure, respiratory rate, body temperature,
         etc. HIIT uses none of those. Google Play's Health Connect
         data-access declaration form is per-permission and requires a
         justification for each — leaving these in would either force
         invented rationale (rejected on review) or dramatically inflate
         review time. Manifest merger takes the union, so we override
         each unused entry with tools:node="remove". -->
    <uses-permission android:name="android.permission.health.WRITE_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" tools:node="remove" />
    <!-- READ_HEART_RATE_VARIABILITY removed 2026-08-01 after a Play rejection
         under the Health Connect "Minimum Scope" policy. It was declared and
         requested, but nothing ever wrote HRV to health_metrics (METRIC_MAP in
         useHealthSync.ts has no entry for it), so no feature consumed it —
         Google was correct. The plugin still injects it, so it needs an explicit
         remove, not just deletion of our declaration. Do not re-add without a
         visible feature and a matching Play Console justification. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_MINDFULNESS" tools:node="remove" />

    <!-- Google Play Services transitively declares AD_ID via
         Firebase-Messaging → Play Services deps. HIIT does not use the
         advertising ID for anything (no ads, no marketing tracking).
         Strip it here so Play Console's Data Safety declaration can
         honestly answer "No" to the AD_ID question and users see no
         "uses advertising ID" tag on the store listing. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <!-- Same story with the newer Android 13+ Privacy Sandbox
         AdServices permissions — transitively declared by Play Services
         but not consumed by any HIIT code path. Removing keeps the app's
         permission surface honest with the "no advertising use"
         declaration. -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />
</manifest>
