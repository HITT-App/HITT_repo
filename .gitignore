# Garmin Connect IQ build artefacts. `.iq` is the store-uploadable package
# (500+ KB per version, regenerated on every release build); `.prg` and
# related debug files are intermediate. Sources are what live in git.
*.iq
*.prg
*.prg.debug.xml

# Private developer key for signing CIQ builds — never commit
*.der
hitt-connect-iq-developer.key

# Design working files (mockups, splash/icon options) — not part of the build
garmin/*.pdf
